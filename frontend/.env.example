# Copy to .env.local for local development. Placeholder values only.
# Everything prefixed NEXT_PUBLIC_ ships to the browser: never put secrets here.

# Base URL of the backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Build-time only: sub-path the static site is served from on GitHub Pages
# (the repo name, with a leading slash). Leave empty for local development.
BASE_PATH=
