# Placeholders only. Copy to .env (gitignored) and fill in; real values live in Render's env settings.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://santa:santa@localhost:5432/santa
# At least 32 characters, random. Rotating it invalidates every issued code.
CODE_HMAC_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_IDLE_TIMEOUT_MINUTES=10
LOGIN_FAILURES_PER_IP=10
LOGIN_FAILURES_PER_IP_WINDOW_MINUTES=15
LOGIN_FAILURES_GLOBAL=50
LOGIN_FAILURES_GLOBAL_WINDOW_MINUTES=60
# JSON list: the GitHub Pages origin (scheme + host, no path) in production.
CORS_ORIGINS=["http://localhost:3000"]
